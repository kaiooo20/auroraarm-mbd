inicio -> REDUZIDA;
NORMAL [label="NORMAL\nhabilita=1  lim_vel=0", fillcolor="#cde2fb"];
REDUZIDA [label="REDUZIDA\nhabilita=1  lim_vel=1", fillcolor="#b7d3f6"];
PARADA [label="PARADA\nhabilita=0  lim_vel=1", fillcolor="#f7c9b5"];
AGUARDA_REARME [label="AGUARDA_REARME\nhabilita=0  lim_vel=1", fillcolor="#fbe2b0"];
RETOMADA [label="RETOMADA\nhabilita=1  lim_vel=1", fillcolor="#c6eedc"];
NORMAL -> PARADA [label="T1: mao=1", color="#6b6b6b", penwidth=1.0, fontcolor="#2b2b2b"];
NORMAL -> REDUZIDA [label="T2: zona=1", color="#6b6b6b", penwidth=1.0, fontcolor="#2b2b2b"];
