digraph G {
rankdir=TB; bgcolor="white"; nodesep=0.6; ranksep=0.55;
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#6b6b6b"];
edge [fontname="DejaVu Sans", fontsize=9, color="#6b6b6b"];
