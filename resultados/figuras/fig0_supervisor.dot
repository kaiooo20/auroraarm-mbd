REDUZIDA -> NORMAL [label="T4: zona=0", color="#6b6b6b", penwidth=1.0, fontcolor="#2b2b2b"];
PARADA -> AGUARDA_REARME [label="T5: mao=0", color="#6b6b6b", penwidth=1.0, fontcolor="#2b2b2b"];
AGUARDA_REARME -> PARADA [label="T6: mao=1", color="#6b6b6b", penwidth=1.0, fontcolor="#2b2b2b"];
AGUARDA_REARME -> RETOMADA [label="T7: rearme=1", color="#6b6b6b", penwidth=1.0, fontcolor="#2b2b2b"];
RETOMADA -> PARADA [label="T8: mao=1", color="#d03b3b", penwidth=2.2, fontcolor="#d03b3b"];
RETOMADA -> REDUZIDA [label="T9: chegou=1", color="#6b6b6b", penwidth=1.0, fontcolor="#2b2b2b"];
}